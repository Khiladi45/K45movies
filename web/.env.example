# Trusted provider API for fallback bundles and metadata.
K45MOVIES_API_BASE_URL=https://raw.githubusercontent.com/Khiladi45/K45movies-api/fce60ad0758822f734f505ef08661f837a450cbb/
# Optional API-only mode for comparisons.
K45_PROVIDER_SOURCE=
# Set a stable, random secret (at least 32 characters) for shared or deployed instances.
K45_REFERENCE_SECRET=
# Optional header overwritten by trusted ingress. Otherwise provider requests use a signed client cookie.
K45_TRUSTED_CLIENT_IP_HEADER=
# Optional HTTPS Redis REST adapter. Set both variables to share provider state across instances.
K45_KV_REST_URL=
K45_KV_REST_TOKEN=
# Optional full FFmpeg executable for MKV compatibility playback (MP4 video copy and AAC audio).
K45_FFMPEG_PATH=
TMDB_API_KEY=
NEXT_PUBLIC_TMDB_KEY=
