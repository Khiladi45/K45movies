{
  "manifest_version": 3,
  "name": "K45movies Browser Bridge",
  "description": "Connect K45movies Pages to its live provider using browser-local requests.",
  "version": "1.2.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "K45movies provider access",
    "default_popup": "permissions.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "externally_connectable": {
    "matches": [
      "https://khiladi45.github.io/K45movies/*"
    ]
  }
}
