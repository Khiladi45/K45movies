+    right: 4,
+    bottom: 4,
+    backgroundColor: "rgba(0,0,0,0.8)",
+    borderRadius: 4,
+    paddingHorizontal: 4,
+    paddingVertical: 1,
+  },
+  live: { backgroundColor: YT.red },
+  badgeText: { color: "#fff", fontSize: 11, fontWeight: "600" },
+  info: { flex: 1, minWidth: 0, gap: 2 },
+  title: { color: YT.text, fontSize: 14, fontWeight: "500", lineHeight: 18 },
