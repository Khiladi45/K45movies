index 0000000..b9b84cd
--- /dev/null
+++ b/src/YouTube/screens/YtVideoScreen.tsx
@@ -0,0 +1,280 @@
+import React, { useCallback, useRef, useState } from "react";
+import {
+  ActivityIndicator,
+  FlatList,
+  ScrollView,
+  StyleSheet,
+  Text,
+  TouchableOpacity,
+  View,
+  useWindowDimensions,
+} from "react-native";
+import { Image } from "expo-image";
+import { Ionicons } from "@expo/vector-icons";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { useNavigation, useRoute } from "@react-navigation/native";
+import { startDownload } from "@/services/downloadManager";
+import { useYtWatch } from "../hooks";
+import { useYtLibraryStore } from "../store";
+import { YT } from "../theme";
+import type { YtVideo } from "../types";
+import { notify, shareVideo } from "../utils";
+import YtPlayer, { YtPlayerHandle } from "../components/YtPlayer";
+
+type Params = {
+  video?: YtVideo;
+  /** Used when only a link is known (e.g. a downloaded file). */
+  link?: string;
+  title?: string;
+  /** Local file to play instead of streaming. */
+  localUri?: string;
+};
+
+const RELATED_W = 220;
+
+export default function YtVideoScreen() {
+  const navigation = useNavigation<any>();
+  const route = useRoute<any>();
+  const insets = useSafeAreaInsets();
+  const { width } = useWindowDimensions();
+  const params: Params = route.params ?? {};
+  const link = params.video?.link ?? params.link ?? "";
+  const playerRef = useRef<YtPlayerHandle>(null);
+  const [expanded, setExpanded] = useState(false);
+
+  const watch = useYtWatch(params.video, link, !params.localUri);
+  const video: YtVideo | undefined = watch.data?.video ?? params.video;
+  const title = video?.title ?? params.title ?? "Video";
+
+  const saved = useYtLibraryStore((s) => (video ? s.isSaved(video.id) : false));
+  const toggleSaved = useYtLibraryStore((s) => s.toggleSaved);
+
+  const onSave = () => {
+    if (!video) return;
+    notify(toggleSaved(video) ? "Saved to Watchlist" : "Removed from Watchlist");
+  };
+
+  const onDownload = async () => {
+    if (!video) return;
+    const result = await startDownload({
+      link: video.link,
+      title: video.title,
+      providerId: "youtube",
+      type: "movie",
+      image: video.image,
+    });
+    notify(result.ok ? "Download started" : result.error || "Couldn't start download");
+  };
+
+  const onPip = () => {
+    if (!playerRef.current?.enterPip()) {
+      notify("Picture-in-Picture isn't available on this device");
+    }
+  };
+
+  const openRelated = useCallback(
+    (item: YtVideo) =>
+      item.isShort
+        ? navigation.navigate("Shorts", { items: [item], startIndex: 0 })
+        : navigation.push("YtVideo", { video: item }),
+    [navigation],
+  );
+
+  const meta = [video?.views, video?.publishedTime].filter(Boolean).join(" · ");
+  const related = watch.data?.related ?? [];
+  const description = watch.data?.description ?? "";
+
+  return (
+    <View style={[styles.root, { paddingTop: insets.top }]}>
+      <View style={{ width, height: Math.round((width * 9) / 16) }}>
+        <YtPlayer
+          ref={playerRef}
+          link={link}
+          localUri={params.localUri}
+          controls
+          style={StyleSheet.absoluteFill}
+        />
+        <TouchableOpacity
+          style={[styles.playerBtn, { left: 4 }]}
+          onPress={() => navigation.goBack()}
+          accessibilityLabel="Back"
+        >
+          <Ionicons name="chevron-down" size={26} color="#fff" />
+        </TouchableOpacity>
+        <View style={styles.playerRight}>
+          <TouchableOpacity
+            style={styles.playerBtn}
+            onPress={onPip}
+            accessibilityLabel="Picture in picture"
+          >
+            <Ionicons name="albums-outline" size={22} color="#fff" />
+          </TouchableOpacity>
+          <TouchableOpacity
+            style={styles.playerBtn}
+            onPress={() => playerRef.current?.enterFullscreen()}
+            accessibilityLabel="Fullscreen"
+          >
+            <Ionicons name="expand-outline" size={22} color="#fff" />
+          </TouchableOpacity>
+        </View>
+      </View>
+
+      <ScrollView contentContainerStyle={{ paddingBottom: insets.bottom + 24 }}>
+        <View style={styles.block}>
+          <Text style={styles.title}>{title}</Text>
+          {meta ? <Text style={styles.meta}>{meta}</Text> : null}
+        </View>
+
+        <View style={styles.channelRow}>
+          {video?.channelAvatar ? (
+            <Image source={{ uri: video.channelAvatar }} style={styles.avatar} />
+          ) : (
+            <View style={[styles.avatar, styles.avatarFallback]}>
+              <Ionicons name="person" size={20} color={YT.muted} />
+            </View>
+          )}
+          <Text style={styles.channel} numberOfLines={1}>
+            {video?.channelName || "Channel"}
+          </Text>
+        </View>
+
+        <ScrollView
+          horizontal
+          showsHorizontalScrollIndicator={false}
+          contentContainerStyle={styles.actions}
+        >
+          <ActionChip icon="share-social-outline" label="Share" onPress={() => video && shareVideo(video)} />
+          <ActionChip
+            icon={saved ? "bookmark" : "bookmark-outline"}
+            label={saved ? "Saved" : "Save"}
+            onPress={onSave}
+          />
+          {!params.localUri ? (
+            <ActionChip icon="download-outline" label="Download" onPress={onDownload} />
+          ) : null}
+          {watch.data?.likes ? (
+            <View style={styles.chip}>
+              <Ionicons name="thumbs-up-outline" size={18} color={YT.text} />
+              <Text style={styles.chipText}>{watch.data.likes}</Text>
+            </View>
+          ) : null}
+        </ScrollView>
+
+        {description ? (
+          <TouchableOpacity
+            activeOpacity={0.8}
+            onPress={() => setExpanded((v) => !v)}
+            style={styles.description}
+          >
+            <Text style={styles.descText} numberOfLines={expanded ? undefined : 3}>
+              {description}
+            </Text>
+            <Text style={styles.more}>{expanded ? "Show less" : "...more"}</Text>
+          </TouchableOpacity>
+        ) : null}
+
+        {!params.localUri ? (
+          <View style={styles.relatedHead}>
+            <Text style={styles.relatedTitle}>Related videos</Text>
+          </View>
+        ) : null}
+        {!params.localUri && watch.isLoading ? (
+          <ActivityIndicator color={YT.red} style={{ marginTop: 16 }} />
+        ) : null}
+        {!params.localUri && related.length > 0 ? (
+          <FlatList
+            horizontal
+            data={related}
+            keyExtractor={(item) => item.id}
+            showsHorizontalScrollIndicator={false}
+            contentContainerStyle={styles.relatedList}
+            renderItem={({ item }) => (
+              <TouchableOpacity
+                activeOpacity={0.85}
+                style={styles.card}
+                onPress={() => openRelated(item)}
+                accessibilityRole="button"
+                accessibilityLabel={item.title}
+              >
+                <View style={styles.cardThumb}>
+                  <Image source={{ uri: item.image }} style={StyleSheet.absoluteFill} contentFit="cover" />
+                  {item.duration ? (
+                    <View style={styles.badge}>
+                      <Text style={styles.badgeText}>{item.duration}</Text>
+                    </View>
+                  ) : null}
+                </View>
+                <Text style={styles.cardTitle} numberOfLines={2}>
+                  {item.title}
+                </Text>
+                <Text style={styles.cardSub} numberOfLines={1}>
+                  {item.channelName}
+                </Text>
+                <Text style={styles.cardSub} numberOfLines={1}>
+                  {[item.views, item.publishedTime].filter(Boolean).join(" · ")}
+                </Text>
+              </TouchableOpacity>
+            )}
+          />
+        ) : null}
+        {!params.localUri && !watch.isLoading && related.length === 0 ? (
+          <Text style={styles.none}>No related videos found.</Text>
+        ) : null}
+      </ScrollView>
+    </View>
+  );
+}
+
+function ActionChip({
+  icon,
+  label,
+  onPress,
+}: {
+  icon: React.ComponentProps<typeof Ionicons>["name"];
+  label: string;
+  onPress: () => void;
+}) {
+  return (
+    <TouchableOpacity style={styles.chip} onPress={onPress} accessibilityRole="button">
+      <Ionicons name={icon} size={18} color={YT.text} />
+      <Text style={styles.chipText}>{label}</Text>
+    </TouchableOpacity>
+  );
+}
+
+const styles = StyleSheet.create({
+  root: { flex: 1, backgroundColor: YT.bg },
+  playerBtn: { width: 44, height: 44, alignItems: "center", justifyContent: "center" },
+  playerRight: { position: "absolute", right: 4, top: 0, flexDirection: "row" },
+  block: { paddingHorizontal: 12, paddingTop: 12 },
+  title: { color: YT.text, fontSize: 18, fontWeight: "700", lineHeight: 24 },
+  meta: { color: YT.muted, fontSize: 12, paddingTop: 4 },
+  channelRow: { flexDirection: "row", alignItems: "center", gap: 10, paddingHorizontal: 12, paddingTop: 14 },
+  avatar: { width: 40, height: 40, borderRadius: 20, backgroundColor: YT.surface },
+  avatarFallback: { alignItems: "center", justifyContent: "center" },
+  channel: { flex: 1, color: YT.text, fontSize: 14, fontWeight: "500" },
+  actions: { paddingHorizontal: 12, paddingVertical: 14, gap: 8 },
+  chip: {
+    height: 36,
+    paddingHorizontal: 14,
+    borderRadius: 18,
+    backgroundColor: YT.surface,
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 6,
+  },
+  chipText: { color: YT.text, fontSize: 13, fontWeight: "500" },
+  description: { marginHorizontal: 12, padding: 12, borderRadius: 12, backgroundColor: YT.surfaceAlt },
+  descText: { color: YT.text, fontSize: 13, lineHeight: 18 },
+  more: { color: YT.muted, fontSize: 13, paddingTop: 4 },
+  relatedHead: { paddingHorizontal: 12, paddingTop: 18, paddingBottom: 10 },
+  relatedTitle: { color: YT.text, fontSize: 16, fontWeight: "700" },
+  relatedList: { paddingHorizontal: 12, gap: 12 },
+  card: { width: RELATED_W },
+  cardThumb: { width: RELATED_W, height: 124, borderRadius: 10, overflow: "hidden", backgroundColor: YT.surface },
+  badge: { position: "absolute", right: 6, bottom: 6, backgroundColor: "rgba(0,0,0,0.8)", borderRadius: 4, paddingHorizontal: 4, paddingVertical: 1 },
+  badgeText: { color: "#fff", fontSize: 11, fontWeight: "600" },
+  cardTitle: { color: YT.text, fontSize: 14, fontWeight: "500", lineHeight: 18, paddingTop: 8 },
+  cardSub: { color: YT.muted, fontSize: 12, paddingTop: 2 },
+  none: { color: YT.muted, fontSize: 13, paddingHorizontal: 12 },
+});
diff --git a/src/YouTube/screens/YtWatchlistScreen.tsx b/src/YouTube/screens/YtWatchlistScreen.tsx
new file mode 100644
index 0000000..7a3694c
--- /dev/null
+++ b/src/YouTube/screens/YtWatchlistScreen.tsx
@@ -0,0 +1,282 @@
+import React, { useCallback, useMemo, useState } from "react";
+import {
+  Alert,
+  FlatList,
+  StyleSheet,
+  Text,
+  TouchableOpacity,
+  View,
+} from "react-native";
+import { Ionicons } from "@expo/vector-icons";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { useNavigation } from "@react-navigation/native";
+import {
+  cancelDownload,
+  deleteDownload,
+  formatBytes,
+  retryDownload,
+  startDownload,
+} from "@/services/downloadManager";
+import { downloadFileExists } from "@/lib/localPlayback";
+import {
+  isActiveDownload,
+  useDownloadsStore,
+  type DownloadJob,
+} from "@/store/useDownloadsStore";
+import { useYtLibraryStore } from "../store";
+import { YT } from "../theme";
+import type { YtVideo } from "../types";
+import { notify } from "../utils";
+import VideoRow from "../components/VideoRow";
+
+type Tab = "saved" | "downloads";
+
+// Download progress is stored as 0..1.
+const percent = (job: DownloadJob) =>
+  Math.max(0, Math.min(100, Math.round((job.progress || 0) * 100)));
+
+const jobToVideo = (job: DownloadJob): YtVideo => ({
+  id: job.id,
+  title: job.title,
+  link: job.link,
+  image: job.image || "",
+  channelName: "",
+  views: "",
+  publishedTime: "",
+  duration: "",
+  aspectRatio: 16 / 9,
+  isShort: false,
+  isLive: false,
+});
+
+export default function YtWatchlistScreen() {
+  const navigation = useNavigation<any>();
+  const insets = useSafeAreaInsets();
+  const [tab, setTab] = useState<Tab>("saved");
+
+  const saved = useYtLibraryStore((s) => s.saved);
+  const removeSaved = useYtLibraryStore((s) => s.removeSaved);
+  const jobs = useDownloadsStore((s) => s.jobs);
+
+  const ytJobs = useMemo(
+    () =>
+      jobs
+        .filter((j) => j.providerId === "youtube")
+        .sort((a, b) => b.createdAt - a.createdAt),
+    [jobs],
+  );
+  const jobFor = useCallback(
+    (link: string) => ytJobs.find((j) => j.link === link),
+    [ytJobs],
+  );
+
+  const play = useCallback(
+    (video: YtVideo) => {
+      const job = jobFor(video.link);
+      if (job?.status === "completed" && downloadFileExists(job) && job.fileUri) {
+        navigation.navigate("YtVideo", { video, localUri: job.fileUri });
+      } else if (video.isShort) {
+        navigation.navigate("Shorts", { items: [video], startIndex: 0 });
+      } else {
+        navigation.navigate("YtVideo", { video });
+      }
+    },
+    [jobFor, navigation],
+  );
+
+  const playJob = useCallback(
+    (job: DownloadJob) => {
+      if (job.status !== "completed") return;
+      if (!downloadFileExists(job) || !job.fileUri) {
+        notify("The downloaded file is no longer on this device.");
+        return;
+      }
+      navigation.navigate("YtVideo", {
+        video: jobToVideo(job),
+        link: job.link,
+        title: job.title,
+        localUri: job.fileUri,
+      });
+    },
+    [navigation],
+  );
+
+  const download = async (video: YtVideo) => {
+    const result = await startDownload({
+      link: video.link,
+      title: video.title,
+      providerId: "youtube",
+      type: "movie",
+      image: video.image,
+    });
+    notify(result.ok ? "Download started" : result.error || "Couldn't start download");
+  };
+
+  const confirmDelete = (job: DownloadJob) =>
+    Alert.alert("Delete download?", job.title, [
+      { text: "Cancel", style: "cancel" },
+      { text: "Delete", style: "destructive", onPress: () => deleteDownload(job.id) },
+    ]);
+
+  const statusFor = (job?: DownloadJob) => {
+    if (!job) return { text: "Saved", color: YT.muted };
+    if (job.status === "completed") {
+      return { text: `Downloaded${job.bytesTotal ? ` · ${formatBytes(job.bytesTotal)}` : ""}`, color: YT.green };
+    }
+    if (isActiveDownload(job.status)) {
+      return { text: `Downloading · ${percent(job)}%`, color: YT.blue };
+    }
+    if (job.status === "error") return { text: "Download failed", color: YT.red };
+    return { text: "Saved", color: YT.muted };
+  };
+
+  return (
+    <View style={[styles.root, { paddingTop: insets.top }]}>
+      <View style={styles.header}>
+        <Text style={styles.title}>Watchlist</Text>
+      </View>
+
+      <View style={styles.tabs}>
+        {(["saved", "downloads"] as Tab[]).map((t) => {
+          const active = tab === t;
+          return (
+            <TouchableOpacity
+              key={t}
+              onPress={() => setTab(t)}
+              accessibilityRole="tab"
+              accessibilityState={{ selected: active }}
+              style={[styles.chip, active && styles.chipActive]}
+            >
+              <Text style={[styles.chipText, active && styles.chipTextActive]}>
+                {t === "saved" ? "Saved" : "Downloads"}
+              </Text>
+            </TouchableOpacity>
+          );
+        })}
+      </View>
+
+      {tab === "saved" ? (
+        <FlatList
+          data={saved}
+          keyExtractor={(v) => v.id}
+          ListEmptyComponent={
+            <Text style={styles.empty}>Videos you save appear here.</Text>
+          }
+          renderItem={({ item }) => {
+            const job = jobFor(item.link);
+            const status = statusFor(job);
+            const downloaded = job?.status === "completed";
+            const busy = !!job && isActiveDownload(job.status);
+            return (
+              <VideoRow
+                video={item}
+                onPress={play}
+                statusLine={
+                  <Text style={{ color: status.color, fontSize: 12, lineHeight: 16 }}>
+                    {status.text}
+                  </Text>
+                }
+                right={
+                  <View style={styles.actions}>
+                    <TouchableOpacity
+                      style={styles.iconBtn}
+                      accessibilityLabel={downloaded ? "Downloaded" : "Download"}
+                      disabled={downloaded || busy}
+                      onPress={() => download(item)}
+                    >
+                      <Ionicons
+                        name={downloaded ? "checkmark-circle" : "download-outline"}
+                        size={22}
+                        color={downloaded ? YT.green : busy ? YT.muted : YT.text}
+                      />
+                    </TouchableOpacity>
+                    <TouchableOpacity
+                      style={styles.iconBtn}
+                      accessibilityLabel="Remove from Watchlist"
+                      onPress={() => removeSaved(item.id)}
+                    >
+                      <Ionicons name="close" size={22} color={YT.muted} />
+                    </TouchableOpacity>
+                  </View>
+                }
+              />
+            );
+          }}
+          contentContainerStyle={{ paddingBottom: 16 }}
+        />
+      ) : (
+        <FlatList
+          data={ytJobs}
+          keyExtractor={(j) => j.id}
+          ListEmptyComponent={
+            <Text style={styles.empty}>Downloaded videos appear here.</Text>
+          }
+          renderItem={({ item: job }) => {
+            const status = statusFor(job);
+            const active = isActiveDownload(job.status);
+            return (
+              <View>
+                <VideoRow
+                  video={jobToVideo(job)}
+                  onPress={() => playJob(job)}
+                  statusLine={
+                    <Text style={{ color: status.color, fontSize: 12, lineHeight: 16 }}>
+                      {status.text}
+                    </Text>
+                  }
+                  right={
+                    <View style={styles.actions}>
+                      {job.status === "error" || job.status === "cancelled" ? (
+                        <TouchableOpacity
+                          style={styles.iconBtn}
+                          accessibilityLabel="Retry download"
+                          onPress={() => retryDownload(job.id)}
+                        >
+                          <Ionicons name="refresh" size={22} color={YT.text} />
+                        </TouchableOpacity>
+                      ) : null}
+                      <TouchableOpacity
+                        style={styles.iconBtn}
+                        accessibilityLabel={active ? "Cancel download" : "Delete download"}
+                        onPress={() => (active ? cancelDownload(job.id) : confirmDelete(job))}
+                      >
+                        <Ionicons name={active ? "pause" : "trash-outline"} size={22} color={YT.text} />
+                      </TouchableOpacity>
+                    </View>
+                  }
+                />
+                {active ? (
+                  <View style={styles.track}>
+                    <View
+                      style={[
+                        styles.fill,
+                        { width: `${percent(job)}%` },
+                      ]}
+                    />
+                  </View>
+                ) : null}
+              </View>
+            );
+          }}
+          contentContainerStyle={{ paddingBottom: 16 }}
+        />
+      )}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  root: { flex: 1, backgroundColor: YT.bg },
+  header: { height: 56, justifyContent: "center", paddingHorizontal: 16 },
+  title: { color: YT.text, fontSize: 20, fontWeight: "700" },
+  tabs: { height: 48, flexDirection: "row", alignItems: "center", gap: 8, paddingHorizontal: 12 },
+  chip: { height: 32, paddingHorizontal: 14, borderRadius: 8, backgroundColor: YT.surface, justifyContent: "center" },
+  chipActive: { backgroundColor: YT.text },
+  chipText: { color: YT.text, fontSize: 14, fontWeight: "500" },
+  chipTextActive: { color: YT.bg },
+  empty: { color: YT.muted, fontSize: 14, textAlign: "center", marginTop: 48 },
+  actions: { justifyContent: "center" },
