@@ -0,0 +1,139 @@
+import React from "react";
+import {
+  Alert,
+  Dimensions,
+  FlatList,
+  StyleSheet,
+  Text,
+  TouchableOpacity,
+  View,
+} from "react-native";
+import { Ionicons } from "@expo/vector-icons";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { useThemeStore } from "@/store/useThemeStore";
+import {
+  useTmdbWatchlistStore,
+  type TmdbWatchlistItem,
+} from "@/store/useTmdbWatchlistStore";
+import { PosterCard, useOpenTitle } from "../components/common";
+
+const COLUMNS = 3;
+const GAP = 14;
+const CARD_WIDTH = Math.floor(
+  (Dimensions.get("window").width - 32 - GAP * (COLUMNS - 1)) / COLUMNS,
+);
+
+/** Watchlist tab for the Movie Based layout (its own store). */
+export default function TmdbWatchlistScreen({ navigation }: any) {
+  const { primaryColor } = useThemeStore();
+  const insets = useSafeAreaInsets();
+  const open = useOpenTitle();
+  const items = useTmdbWatchlistStore((s) => s.items);
+  const remove = useTmdbWatchlistStore((s) => s.remove);
+
+  const sorted = [...items].sort((a, b) => b.addedAt - a.addedAt);
+
+  const confirmRemove = (item: TmdbWatchlistItem) => {
+    Alert.alert("Remove from Watchlist?", `"${item.title}" will be removed.`, [
+      { text: "Cancel", style: "cancel" },
+      { text: "Remove", style: "destructive", onPress: () => remove(item.key) },
+    ]);
+  };
+
+  return (
+    <View style={[styles.container, { paddingTop: insets.top }]}>
+      <View style={styles.header}>
+        <View style={styles.headerLeft}>
+          <Text style={styles.headerTitle}>My Watchlist</Text>
+          <View
+            style={[
+              styles.count,
+              { backgroundColor: `${primaryColor}20`, borderColor: `${primaryColor}40` },
+            ]}
+          >
+            <Text style={[styles.countText, { color: primaryColor }]}>
+              {items.length}
+            </Text>
+          </View>
+        </View>
+        <Ionicons name="bookmark" size={26} color={primaryColor} />
+      </View>
+
+      {sorted.length === 0 ? (
+        <View style={styles.empty}>
+          <Ionicons name="bookmark-outline" size={72} color="#444" />
+          <Text style={styles.emptyTitle}>Your watchlist is empty</Text>
+          <Text style={styles.emptyText}>
+            Tap the + icon on any movie or series to save it here for later
+          </Text>
+          <TouchableOpacity
+            style={[styles.explore, { backgroundColor: primaryColor }]}
+            onPress={() => navigation.navigate("HomeTab")}
+          >
+            <Text style={styles.exploreText}>Explore Content</Text>
+          </TouchableOpacity>
+        </View>
+      ) : (
+        <FlatList
+          data={sorted}
+          numColumns={COLUMNS}
+          keyExtractor={(item) => item.key}
+          columnWrapperStyle={{ gap: GAP, paddingHorizontal: 16 }}
+          contentContainerStyle={{ paddingBottom: 110, paddingTop: 8 }}
+          showsVerticalScrollIndicator={false}
+          renderItem={({ item }) => (
+            <View style={{ width: CARD_WIDTH, marginBottom: 18 }}>
+              <PosterCard
+                item={item}
+                width={CARD_WIDTH}
+                onPress={() => open(item)}
+              />
+              <TouchableOpacity
+                style={styles.remove}
+                onPress={() => confirmRemove(item)}
+                hitSlop={{ top: 10, bottom: 10, left: 10, right: 10 }}
+                accessibilityLabel={`Remove ${item.title} from watchlist`}
+              >
+                <Ionicons name="close" size={14} color="#fff" />
+              </TouchableOpacity>
+            </View>
+          )}
+        />
+      )}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: { flex: 1, backgroundColor: "#050505" },
+  header: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+    paddingHorizontal: 20,
+    paddingTop: 12,
+    paddingBottom: 20,
+  },
+  headerLeft: { flexDirection: "row", alignItems: "center", gap: 10 },
+  headerTitle: { fontSize: 26, fontWeight: "800", color: "#fff", letterSpacing: -0.5 },
+  count: { paddingHorizontal: 10, paddingVertical: 3, borderRadius: 10, borderWidth: 1 },
+  countText: { fontSize: 12, fontWeight: "800" },
+  empty: { flex: 1, alignItems: "center", justifyContent: "center", paddingHorizontal: 40, gap: 8 },
+  emptyTitle: { color: "#fff", fontSize: 20, fontWeight: "700", marginTop: 8 },
+  emptyText: { color: "#888", fontSize: 14, textAlign: "center", lineHeight: 20, marginBottom: 14 },
+  explore: { paddingHorizontal: 24, paddingVertical: 12, borderRadius: 12 },
+  exploreText: { color: "#fff", fontWeight: "700", fontSize: 15 },
+  remove: {
+    position: "absolute",
+    top: 6,
+    right: 6,
+    width: 24,
+    height: 24,
+    borderRadius: 12,
+    backgroundColor: "rgba(0,0,0,0.75)",
+    borderWidth: 1,
+    borderColor: "rgba(255,255,255,0.2)",
+    alignItems: "center",
+    justifyContent: "center",
+  },
+});
diff --git a/src/components/LayoutSettingsSection.tsx b/src/components/LayoutSettingsSection.tsx
new file mode 100644
index 0000000..38564cf
--- /dev/null
+++ b/src/components/LayoutSettingsSection.tsx
@@ -0,0 +1,237 @@
+import React from "react";
+import { StyleSheet, Text, TouchableOpacity, View } from "react-native";
+import { Ionicons, MaterialCommunityIcons } from "@expo/vector-icons";
+import { Dropdown } from "react-native-element-dropdown";
+import { useThemeStore } from "@/store/useThemeStore";
+import { useLayoutStore, type AppLayout } from "@/store/useLayoutStore";
+import { AUDIO_LANGUAGE_OPTIONS } from "@/lib/languages";
+
+const OPTIONS: {
+  value: AppLayout;
+  title: string;
+  description: string;
+  icon: React.ComponentProps<typeof MaterialCommunityIcons>["name"];
+}[] = [
+  {
+    value: "provider",
+    title: "Provider Based",
+    description: "Browse and search inside your installed providers",
+    icon: "puzzle-outline",
+  },
+  {
+    value: "movie",
+    title: "Movie Based",
+    description: "Browse movies and series from TMDB, then find streams",
+    icon: "movie-open-outline",
+  },
+];
+
+/**
+ * Settings → LAYOUT. Rendered as one extra section on the Settings screen; it
+ * only reads/writes useLayoutStore.
+ */
+export default function LayoutSettingsSection() {
+  const { primaryColor } = useThemeStore();
+  const layout = useLayoutStore((s) => s.layout);
+  const setLayout = useLayoutStore((s) => s.setLayout);
+  const preferredLanguage = useLayoutStore((s) => s.preferredLanguage);
+  const setPreferredLanguage = useLayoutStore((s) => s.setPreferredLanguage);
+
+  return (
+    <View style={styles.sectionContainer}>
+      <View style={styles.sectionHeader}>
+        <View style={[styles.accent, { backgroundColor: primaryColor }]} />
+        <Text style={styles.sectionTitle}>LAYOUT</Text>
+        <MaterialCommunityIcons
+          name="creation"
+          size={12}
+          color="#555"
+          style={{ marginLeft: 4 }}
+        />
+      </View>
+
+      <View style={styles.card}>
+        <View style={styles.rowHead}>
+          <View
+            style={[styles.iconBox, { backgroundColor: `${primaryColor}1A` }]}
+          >
+            <MaterialCommunityIcons
+              name="view-dashboard-outline"
+              size={24}
+              color={primaryColor}
+            />
+          </View>
+          <View style={styles.rowText}>
+            <Text style={styles.title}>Choose Layout</Text>
+            <Text style={styles.subtitle}>
+              Switch how Home and Search find content
+            </Text>
+          </View>
+        </View>
+
+        <View style={styles.options}>
+          {OPTIONS.map((option) => {
+            const selected = layout === option.value;
+            return (
+              <TouchableOpacity
+                key={option.value}
+                activeOpacity={0.8}
+                onPress={() => setLayout(option.value)}
+                accessibilityRole="radio"
+                accessibilityState={{ selected }}
+                style={[
+                  styles.option,
+                  selected && {
+                    borderColor: primaryColor,
+                    backgroundColor: `${primaryColor}14`,
+                  },
+                ]}
+              >
+                <MaterialCommunityIcons
+                  name={option.icon}
+                  size={22}
+                  color={selected ? primaryColor : "#8b93a0"}
+                />
+                <View style={styles.optionText}>
+                  <Text
+                    style={[
+                      styles.optionTitle,
+                      selected && { color: "#fff" },
+                    ]}
+                  >
+                    {option.title}
+                    {option.value === "provider" ? "  (Default)" : ""}
+                  </Text>
+                  <Text style={styles.optionDesc}>{option.description}</Text>
+                </View>
+                <Ionicons
+                  name={selected ? "radio-button-on" : "radio-button-off"}
+                  size={20}
+                  color={selected ? primaryColor : "#555"}
+                />
+              </TouchableOpacity>
+            );
+          })}
+        </View>
+
+        {layout === "movie" ? (
+          <View style={styles.languageBlock}>
+            <View style={styles.rowHead}>
+              <View
+                style={[styles.iconBox, { backgroundColor: "rgba(56,189,248,0.1)" }]}
+              >
+                <Ionicons name="language-outline" size={24} color="#38bdf8" />
+              </View>
+              <View style={styles.rowText}>
+                <Text style={styles.title}>Preferred Audio Language</Text>
+                <Text style={styles.subtitle}>
+                  Streams with this audio are listed first
+                </Text>
+              </View>
+            </View>
+            <Dropdown
+              style={styles.dropdown}
+              containerStyle={styles.dropdownList}
+              placeholderStyle={styles.dropdownPlaceholder}
+              selectedTextStyle={styles.dropdownSelected}
+              itemTextStyle={styles.dropdownItem}
+              inputSearchStyle={styles.dropdownSearch}
+              activeColor={`${primaryColor}22`}
+              iconColor="#8b93a0"
+              data={AUDIO_LANGUAGE_OPTIONS}
+              labelField="label"
+              valueField="value"
+              search
+              searchPlaceholder="Search language"
+              maxHeight={320}
+              placeholder="Select language"
+              value={preferredLanguage}
+              onChange={(item: { value: string }) =>
+                setPreferredLanguage(item.value)
+              }
+            />
+          </View>
+        ) : null}
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  sectionContainer: { marginTop: 28, paddingHorizontal: 16 },
+  sectionHeader: {
+    flexDirection: "row",
+    alignItems: "center",
+    marginBottom: 12,
+    paddingLeft: 4,
+  },
+  accent: { width: 3, height: 14, borderRadius: 2, marginRight: 8 },
+  sectionTitle: {
+    fontSize: 12,
+    color: "#888",
+    fontWeight: "700",
+    letterSpacing: 1,
+  },
+  card: {
+    backgroundColor: "#0a0a0a",
+    borderRadius: 20,
