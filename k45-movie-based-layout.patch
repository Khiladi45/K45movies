+// Bridges a TMDB title (movie or series) to the app's existing installed
+// providers. It only *uses* providerApi / loadEpisodes / normalizeStreams — it
+// never changes how providers work.
+//
+//   1. search every installed provider by title (a few at a time, results are
+//      reported the moment each provider finishes)
+//   2. score the posts each provider returns against the TMDB title/year
+//   3. read the best posts' links (getMeta) and turn them into SourceOptions:
+//      one playable row per quality (movies) or per episode quality (series)
+
+import { queryClient } from "@/lib/queryClient";
+import { providerApi } from "@/lib/providerApi";
+import { loadEpisodes } from "@/lib/playerSwitch";
+import {
+  findSameEpisode,
+  parseSeasonNumber,
+  toPlayerEpisodes,
+} from "@/lib/episodes";
+import { normalizeStreams } from "@/lib/streams";
+import {
+  detectLanguagesFromStreams,
+  detectLanguagesFromText,
+  hasMultiAudioHint,
+} from "@/lib/audioLanguages";
+import { TEXT_LANGUAGE_NAMES } from "@/lib/languages";
+import type { LinkItem, DirectLink } from "@/components/SeasonList";
+import type { PlayerEpisode } from "@/store/usePlayerStore";
+import type { TmdbMediaType } from "@/lib/tmdbApi";
+
+export const PROVIDER_CONCURRENCY = 3;
+export const MAX_LANGUAGE_PROBES = 8;
+
+export type BridgeMedia = {
+  mediaType: TmdbMediaType;
+  title: string;
+  originalTitle: string;
+  year: string;
+  numberOfSeasons?: number;
+};
+
+export type ProviderPost = {
+  title: string;
+  link: string;
+  image?: string;
+  type?: string;
+};
+
+export type ProviderMatch = {
+  providerId: string;
+  post: ProviderPost;
+  score: number;
+  meta: any;
+  linkList: LinkItem[];
+};
+
+export type ProviderState =
+  | { providerId: string; status: "searching" }
+  | { providerId: string; status: "done"; matches: ProviderMatch[] }
+  | { providerId: string; status: "empty" }
+  | { providerId: string; status: "error"; message: string };
+
+/** One playable row in the sources list. */
+export type SourceOption = {
+  id: string;
+  providerId: string;
+  matchTitle: string;
+  label: string;
+  detail?: string;
+  height: number | null;
+  sizeText?: string;
+  languages: string[];
+  multiAudio: boolean;
+  languageChecked: boolean;
+  link: string;
+  type: string;
+  // Position of this row inside the provider's own lists; the player uses
+  // them for quality switching and "next episode".
+  linkIndex: number;
+  itemIndex: number;
+  items: PlayerEpisode[];
+  linkList: LinkItem[];
+};
+
+// ---- helpers ---------------------------------------------------------------
+
+async function runPool<T>(
+  items: T[],
+  limit: number,
+  worker: (item: T) => Promise<void>,
+  signal?: AbortSignal,
+) {
+  let next = 0;
+  const lane = async () => {
+    while (next < items.length) {
+      if (signal?.aborted) return;
+      const item = items[next++];
+      try {
+        await worker(item);
+      } catch {
+        // each worker reports its own failures
+      }
+    }
+  };
+  await Promise.all(
+    Array.from({ length: Math.min(limit, items.length) }, () => lane()),
+  );
+}
+
+const NOISE = new Set([
+  "the", "a", "an", "of", "and", "movie", "film", "series", "web", "show",
+  "season", "seasons", "complete", "full", "episode", "episodes", "ep", "part",
+  "download", "watch", "online", "free", "hd", "fhd", "uhd", "4k", "bd", "rip",
+  "web", "dl", "webdl", "webrip", "hdrip", "bluray", "brrip", "dvdrip", "hdtv",
+  "hdcam", "cam", "x264", "x265", "hevc", "h264", "h265", "10bit", "esub",
+  "esubs", "sub", "subs", "subtitle", "subtitles", "dual", "audio", "multi",
+  "dubbed", "dub", "org", "line", "clean", "proper", "extended", "uncut",
+  "remastered", "imax", "amzn", "nf", "dsnp", "hmax", "hbo", "zee5", "hotstar",
+  "jio", "sony", "prime", "netflix", "aac", "ddp", "dd", "atmos", "hdr", "dv",
+  "all", "eps", "official", "original",
+]);
+
+const tokenize = (text: string): string[] =>
+  text
+    .toLowerCase()
+    .normalize("NFKD")
+    .replace(/[̀-ͯ]/g, "")
+    .replace(/&/g, " and ")
+    .replace(/[^a-z0-9]+/g, " ")
+    .split(" ")
+    .filter(Boolean);
+
+const isNoiseToken = (token: string) =>
+  NOISE.has(token) ||
+  !!TEXT_LANGUAGE_NAMES[token] ||
+  /^(?:19|20)\d{2}$/.test(token) ||
+  /^s\d{1,2}(?:e\d{1,3})?$/.test(token) ||
+  /^\d{3,4}p$/.test(token) ||
+  /^\d+(?:gb|mb)$/.test(token) ||
+  /^e\d{1,3}$/.test(token);
+
+const coreTokens = (text: string) =>
+  tokenize(text).filter((token) => !isNoiseToken(token));
+
+const yearsIn = (text: string): number[] =>
+  (text.match(/\b(?:19|20)\d{2}\b/g) || []).map(Number);
+
+/** 0..1 similarity between a TMDB title and a provider post title. */
+export function scoreTitle(
+  media: BridgeMedia,
+  postTitle: string,
+): number {
+  const candidates = [media.title, media.originalTitle].filter(
+    (value, index, list) => !!value && list.indexOf(value) === index,
+  );
+  const postTokens = coreTokens(postTitle);
+  if (postTokens.length === 0) return 0;
+  const postSet = new Set(postTokens);
+
+  let best = 0;
+  for (const candidate of candidates) {
+    const wanted = tokenize(candidate);
+    if (wanted.length === 0) continue;
+    const wantedSet = new Set(wanted);
+    const hits = wanted.filter((token) => postSet.has(token)).length;
+    const recall = hits / wanted.length;
+    const precision =
+      postTokens.filter((token) => wantedSet.has(token)).length /
+      postTokens.length;
+    if (recall === 0 || precision === 0) continue;
+    const f = (2 * recall * precision) / (recall + precision);
+    best = Math.max(best, f);
+  }
+
+  // Movies: a different release year is almost always a different film.
+  if (media.mediaType === "movie" && media.year) {
+    const years = yearsIn(postTitle);
+    if (years.length > 0) {
+      const wanted = Number(media.year);
+      if (!years.some((year) => Math.abs(year - wanted) <= 1)) best *= 0.5;
+    }
+  }
+  return best;
+}
+
+const MIN_SCORE: Record<TmdbMediaType, number> = { movie: 0.6, tv: 0.55 };
+const MAX_MATCHES: Record<TmdbMediaType, number> = { movie: 2, tv: 4 };
+
+// True when every character is Latin script (so providers can search for it).
+const isLatin = (text: string) => !/[^\u0000-ɏ]/.test(text);
+
+function searchQueries(media: BridgeMedia): string[] {
+  const queries = [media.title];
+  if (
+    media.originalTitle &&
+    media.originalTitle !== media.title &&
+    isLatin(media.originalTitle)
+  ) {
+    queries.push(media.originalTitle);
+  }
+  return queries;
+}
+
+async function searchProvider(
+  providerId: string,
+  query: string,
+): Promise<ProviderPost[]> {
+  const results = await queryClient.fetchQuery({
+    queryKey: ["bridge-search", providerId, query.toLowerCase()],
+    queryFn: () => providerApi.search(query, [providerId]),
+    staleTime: 1000 * 60 * 5,
+  });
+  return (Array.isArray(results) ? results : [])
+    .filter((item: any) => item && item.title && item.link)
+    .map((item: any) => ({
+      title: String(item.title),
+      link: String(item.link),
+      image: item.image,
+      type: item.type,
+    }));
+}
+
+const loadMeta = (providerId: string, link: string) =>
+  queryClient.fetchQuery({
+    queryKey: ["meta", providerId, link],
+    queryFn: ({ signal }) => providerApi.getMeta(providerId, link, signal),
+    staleTime: 1000 * 60 * 5,
+  });
+
+async function buildMatches(
+  providerId: string,
+  media: BridgeMedia,
+  posts: ProviderPost[],
+  limit: number,
+  skipLinks: Set<string> = new Set(),
+): Promise<ProviderMatch[]> {
+  const seen = new Set<string>(skipLinks);
+  const ranked = posts
+    .map((post) => ({ post, score: scoreTitle(media, post.title) }))
+    .filter(
+      (entry) =>
+        entry.score >= MIN_SCORE[media.mediaType] && !seen.has(entry.post.link),
+    )
+    .sort((a, b) => b.score - a.score)
+    .filter((entry) => {
+      if (seen.has(entry.post.link)) return false;
+      seen.add(entry.post.link);
+      return true;
+    })
+    .slice(0, limit);
+
+  const matches: ProviderMatch[] = [];
+  await Promise.all(
+    ranked.map(async ({ post, score }) => {
+      try {
+        const meta = await loadMeta(providerId, post.link);
+        matches.push({
+          providerId,
+          post,
+          score,
+          meta,
+          linkList: Array.isArray(meta?.linkList) ? meta.linkList : [],
+        });
+      } catch {
+        // an unreadable post just isn't a candidate
+      }
+    }),
+  );
+  return matches.sort((a, b) => b.score - a.score);
+}
+
+async function matchProvider(
+  providerId: string,
+  media: BridgeMedia,
+): Promise<ProviderMatch[]> {
+  for (const query of searchQueries(media)) {
+    const posts = await searchProvider(providerId, query);
+    const matches = await buildMatches(
+      providerId,
+      media,
+      posts,
+      MAX_MATCHES[media.mediaType],
+    );
+    if (matches.length > 0) return matches;
+  }
+  return [];
+}
+
+/**
+ * Searches every provider (PROVIDER_CONCURRENCY at a time) and calls
+ * `onUpdate` as soon as each one finishes, so fast providers show up first.
+ */
+export async function matchProviders(
+  media: BridgeMedia,
+  providerIds: string[],
+  onUpdate: (state: ProviderState) => void,
+  signal?: AbortSignal,
+): Promise<void> {
+  await runPool(
+    providerIds,
+    PROVIDER_CONCURRENCY,
+    async (providerId) => {
+      try {
+        const matches = await matchProvider(providerId, media);
+        if (signal?.aborted) return;
+        onUpdate(
+          matches.length > 0
+            ? { providerId, status: "done", matches }
+            : { providerId, status: "empty" },
+        );
+      } catch (error: any) {
+        if (signal?.aborted) return;
+        onUpdate({
+          providerId,
+          status: "error",
+          message: error?.message || "Provider failed",
+        });
+      }
+    },
+    signal,
+  );
+}
+
+// ---- turning provider data into rows --------------------------------------
+
+const qualityHeight = (text: string): number | null => {
+  const numeric = /(?:^|[^0-9])(2160|1440|1080|720|576|540|480|360|240)p?(?:[^0-9]|$)/i.exec(
+    text,
+  );
+  if (numeric) return Number(numeric[1]);
+  const lower = text.toLowerCase();
+  if (/\b4k\b|uhd/.test(lower)) return 2160;
+  if (/fhd|full[\s-]*hd/.test(lower)) return 1080;
+  if (/\bhd\b/.test(lower)) return 720;
+  if (/\bsd\b/.test(lower)) return 480;
+  return null;
+};
+
+const sizeOf = (text: string): string | undefined => {
+  const hit = /(\d+(?:\.\d+)?)\s?(GB|MB)/i.exec(text);
+  return hit ? `${hit[1]} ${hit[2].toUpperCase()}` : undefined;
+};
+
+const entryLabel = (entry: LinkItem, fallback = "Stream") =>
+  (entry.title || entry.quality || "").trim() || fallback;
+
+function languagesFor(entryText: string, postTitle: string) {
+  const fromEntry = detectLanguagesFromText(entryText);
+  const languages = fromEntry.length > 0 ? fromEntry : detectLanguagesFromText(postTitle);
+  return {
+    languages,
+    multiAudio: hasMultiAudioHint(entryText) || hasMultiAudioHint(postTitle),
+  };
+}
+
+/** Movie rows: one per playable link of every quality entry. */
+export function buildMovieOptions(match: ProviderMatch): SourceOption[] {
+  const { providerId, post, linkList, meta } = match;
+  const options: SourceOption[] = [];
+  const seen = new Set<string>();
+
+  linkList.forEach((entry, linkIndex) => {
+    const links: DirectLink[] = (entry.directLinks || []).filter(
+      (item) => item && item.link,
+    );
+    links.forEach((item, itemIndex) => {
+      if (seen.has(item.link)) return;
+      seen.add(item.link);
+      const label = entryLabel(entry, item.title || "Stream");
+      const detail =
+        links.length > 1 && item.title && item.title !== label
+          ? item.title
+          : undefined;
+      const text = [entry.title, entry.quality, item.title, item.description]
+        .filter(Boolean)
+        .join(" ");
+      const lang = languagesFor(text, post.title);
+      options.push({
+        id: `${providerId}|${item.link}`,
+        providerId,
+        matchTitle: post.title,
+        label,
+        detail,
+        height: qualityHeight(text),
+        sizeText: sizeOf(text),
+        languages: lang.languages,
+        multiAudio: lang.multiAudio,
+        languageChecked: false,
+        link: item.link,
+        type: item.type || meta?.type || "movie",
+        linkIndex,
+        itemIndex,
+        items: toPlayerEpisodes(links),
+        linkList,
+      });
+    });
+  });
+
+  if (options.length === 0) {
+    // The existing detail page falls back to the post link itself.
+    const lang = languagesFor(post.title, post.title);
+    options.push({
+      id: `${providerId}|${post.link}`,
+      providerId,
+      matchTitle: post.title,
+      label: "Default",
+      height: qualityHeight(post.title),
+      sizeText: sizeOf(post.title),
+      languages: lang.languages,
+      multiAudio: lang.multiAudio,
+      languageChecked: false,
+      link: post.link,
+      type: meta?.type || "movie",
+      linkIndex: 0,
+      itemIndex: 0,
+      items: [],
+      linkList: [],
+    });
+  }
+  return options;
+}
+
+/** Season numbers mentioned in a post title: "S02", "Season 1-3", "S01 to S03". */
+function seasonsInTitle(title: string): Set<number> {
+  const found = new Set<number>();
+  const range = /\bseasons?\s*0*(\d{1,2})\s*(?:-|to|&|and)\s*0*(\d{1,2})\b/i.exec(
+    title,
+  );
+  if (range) {
+    const from = Number(range[1]);
+    const to = Number(range[2]);
+    for (let n = Math.min(from, to); n <= Math.max(from, to) && n < 40; n += 1) {
+      found.add(n);
+    }
+  }
+  const sRange = /\bs0*(\d{1,2})\s*(?:-|to)\s*s?0*(\d{1,2})\b/i.exec(title);
+  if (sRange) {
+    const from = Number(sRange[1]);
+    const to = Number(sRange[2]);
+    for (let n = Math.min(from, to); n <= Math.max(from, to) && n < 40; n += 1) {
+      found.add(n);
+    }
+  }
+  const single = parseSeasonNumber(title);
+  if (single != null) found.add(single);
+  return found;
+}
+
+/** Quality entries of one match that belong to `season`. */
+function entriesForSeason(
+  match: ProviderMatch,
+  season: number,
+  numberOfSeasons: number,
+): { entry: LinkItem; linkIndex: number }[] {
+  const postSeasons = seasonsInTitle(match.post.title);
+  const result: { entry: LinkItem; linkIndex: number }[] = [];
+  match.linkList.forEach((entry, linkIndex) => {
+    const entrySeason = parseSeasonNumber(entry.title);
+    let include: boolean;
+    if (entrySeason != null) include = entrySeason === season;
+    else if (postSeasons.size > 0) include = postSeasons.has(season);
+    else include = season === 1 || numberOfSeasons <= 1;
+    if (include && (entry.episodesLink || (entry.directLinks || []).length > 0)) {
+      result.push({ entry, linkIndex });
+    }
+  });
+  return result;
+}
+
+async function episodesOf(
+  providerId: string,
+  entry: LinkItem,
+): Promise<PlayerEpisode[]> {
+  if (entry.episodesLink) return loadEpisodes(providerId, entry.episodesLink);
+  return toPlayerEpisodes(entry.directLinks);
+}
+
+async function episodeOptionsForMatch(
+  match: ProviderMatch,
+  season: number,
+  episode: number,
+  numberOfSeasons: number,
+  onOptions: (options: SourceOption[]) => void,
+  signal?: AbortSignal,
+): Promise<number> {
+  const entries = entriesForSeason(match, season, numberOfSeasons);
+  let produced = 0;
+  await runPool(
+    entries,
+    2,
+    async ({ entry, linkIndex }) => {
+      const items = await episodesOf(match.providerId, entry);
+      if (signal?.aborted || items.length === 0) return;
+      // A "season pack" with no numbering and fewer rows than the episode we
+      // want cannot contain it; do not guess by position in that case.
+      const numbered = items.some((item) => item.number != null);
+      if (!numbered && items.length < episode) return;
+      const target = findSameEpisode(items, episode, episode - 1);
+      if (!target) return;
+      const itemIndex = items.findIndex((item) => item.link === target.link);
+      const label = entryLabel(entry, "Stream");
+      const text = `${entry.title || ""} ${target.title || ""}`;
+      const lang = languagesFor(text, match.post.title);
+      produced += 1;
+      onOptions([
+        {
+          id: `${match.providerId}|${target.link}`,
+          providerId: match.providerId,
+          matchTitle: match.post.title,
+          label,
+          height: qualityHeight(text),
+          sizeText: sizeOf(text),
+          languages: lang.languages,
+          multiAudio: lang.multiAudio,
+          languageChecked: false,
+          link: target.link,
+          type: target.type || "series",
+          linkIndex,
+          itemIndex: Math.max(0, itemIndex),
+          items,
+          linkList: match.linkList,
+        },
+      ]);
+    },
+    signal,
+  );
+  return produced;
+}
+
+/**
+ * Qualities for one episode across all matched providers. `onOptions` fires as
+ * rows are found. If a provider has no row for the season, one extra targeted
+ * search ("<title> season N") is tried before giving up on it.
+ */
+export async function resolveEpisodeOptions(
+  media: BridgeMedia,
+  matches: ProviderMatch[],
+  season: number,
+  episode: number,
+  onOptions: (providerId: string, options: SourceOption[]) => void,
+  signal?: AbortSignal,
+): Promise<void> {
+  const byProvider = new Map<string, ProviderMatch[]>();
+  matches.forEach((match) => {
+    const list = byProvider.get(match.providerId) || [];
+    list.push(match);
+    byProvider.set(match.providerId, list);
+  });
+  const numberOfSeasons = media.numberOfSeasons ?? 1;
+
+  await runPool(
+    Array.from(byProvider.entries()),
+    PROVIDER_CONCURRENCY,
+    async ([providerId, providerMatches]) => {
+      let produced = 0;
+      for (const match of providerMatches) {
+        if (signal?.aborted) return;
+        produced += await episodeOptionsForMatch(
+          match,
+          season,
+          episode,
+          numberOfSeasons,
+          (options) => onOptions(providerId, options),
+          signal,
+        );
+      }
+      if (produced > 0 || signal?.aborted) return;
+
+      // Fallback: a provider that files each season as its own post.
+      try {
+        const posts = await searchProvider(
+          providerId,
+          `${media.title} season ${season}`,
+        );
+        const known = new Set(providerMatches.map((m) => m.post.link));
+        const extra = await buildMatches(providerId, media, posts, 2, known);
+        for (const match of extra) {
+          if (signal?.aborted) return;
+          await episodeOptionsForMatch(
+            match,
+            season,
+            episode,
+            numberOfSeasons,
+            (options) => onOptions(providerId, options),
+            signal,
+          );
+        }
+      } catch {
+        // nothing more to try for this provider
+      }
+    },
+    signal,
+  );
+}
+
+// ---- language enrichment ---------------------------------------------------
+
+const probeCache = new Map<string, string[]>();
+
+/**
+ * Looks inside rows whose language is unknown (or "multi audio") by resolving
+ * their streams and reading provider metadata / HLS audio groups. Bounded to
+ * MAX_LANGUAGE_PROBES rows and two at a time.
+ */
+export async function enrichLanguages(
+  options: SourceOption[],
+  onResolved: (id: string, languages: string[]) => void,
+  signal?: AbortSignal,
+): Promise<void> {
+  const targets = options
+    .filter(
+      (option) =>
+        !option.languageChecked &&
+        (option.languages.length === 0 || option.multiAudio),
+    )
+    .slice(0, MAX_LANGUAGE_PROBES);
+
+  await runPool(
+    targets,
+    2,
+    async (option) => {
+      const cached = probeCache.get(option.link);
+      if (cached) {
+        onResolved(option.id, cached);
+        return;
+      }
+      const raw = await providerApi.getStream(
+        option.providerId,
+        option.link,
+        option.type,
+        signal,
+      );
+      const streams = normalizeStreams(
+        Array.isArray(raw) ? raw : raw ? [raw] : [],
+      );
+      const codes = await detectLanguagesFromStreams(streams, { signal });
+      probeCache.set(option.link, codes);
+      if (!signal?.aborted) onResolved(option.id, codes);
+    },
+    signal,
+  );
+}
diff --git a/src/lib/tmdbApi.ts b/src/lib/tmdbApi.ts
new file mode 100644
index 0000000..3abcd65
--- /dev/null
+++ b/src/lib/tmdbApi.ts
@@ -0,0 +1,322 @@
+// TMDB client for the Movie Based layout. The key comes from
+// EXPO_PUBLIC_TMDB_KEY and may be either a v3 API key or a v4 "API Read Access
+// Token" (the long JWT) — both are supported.
+
+const BASE = "https://api.themoviedb.org/3";
+const IMG = "https://image.tmdb.org/t/p";
+
+const RAW_KEY = (process.env.EXPO_PUBLIC_TMDB_KEY || "").trim();
+const IS_BEARER = RAW_KEY.startsWith("eyJ") && RAW_KEY.length > 60;
+
+export const tmdbConfigured = (): boolean => RAW_KEY.length > 0;
+
+export type TmdbMediaType = "movie" | "tv";
+
+export type TmdbItem = {
+  id: number;
+  mediaType: TmdbMediaType;
+  title: string;
+  originalTitle: string;
+  overview: string;
+  poster: string | null;
+  backdrop: string | null;
+  year: string;
+  rating: number;
+  originalLanguage: string;
+};
+
+export type TmdbCast = {
+  id: number;
+  name: string;
+  character: string;
+  photo: string | null;
+};
+
+export type TmdbSeasonSummary = {
+  number: number;
+  name: string;
+  episodeCount: number;
+  airYear: string;
+  poster: string | null;
+};
+
+export type TmdbDetails = TmdbItem & {
+  tagline: string;
+  genres: string[];
+  runtime: number | null;
+  status: string;
+  certification: string;
+  cast: TmdbCast[];
+  trailerKey: string | null;
+  similar: TmdbItem[];
+  spokenLanguages: string[];
+  seasons: TmdbSeasonSummary[];
+  numberOfSeasons: number;
+  numberOfEpisodes: number;
+};
+
+export type TmdbEpisode = {
+  number: number;
+  name: string;
+  overview: string;
+  still: string | null;
+  runtime: number | null;
+  airDate: string;
+  rating: number;
+};
+
+export type TmdbSeason = {
+  number: number;
+  name: string;
+  overview: string;
+  episodes: TmdbEpisode[];
+};
+
+export const tmdbImage = (
+  path: string | null | undefined,
+  size: "w185" | "w342" | "w500" | "w780" | "original" = "w342",
+): string | null => (path ? `${IMG}/${size}${path}` : null);
+
+async function request<T = any>(
+  path: string,
+  params: Record<string, string | number | boolean | undefined> = {},
+  signal?: AbortSignal,
+): Promise<T> {
+  if (!RAW_KEY) {
+    throw new Error(
+      "TMDB key missing. Set EXPO_PUBLIC_TMDB_KEY in your .env and rebuild.",
+    );
+  }
+  const query = new URLSearchParams();
+  if (!IS_BEARER) query.set("api_key", RAW_KEY);
+  query.set("language", "en-US");
+  Object.entries(params).forEach(([key, value]) => {
+    if (value !== undefined && value !== "") query.set(key, String(value));
+  });
+
+  const response = await fetch(`${BASE}${path}?${query.toString()}`, {
+    signal,
+    headers: IS_BEARER
+      ? { Authorization: `Bearer ${RAW_KEY}`, accept: "application/json" }
+      : { accept: "application/json" },
+  });
+  if (!response.ok) {
+    throw new Error(
+      response.status === 401
+        ? "TMDB rejected the API key (401). Check EXPO_PUBLIC_TMDB_KEY."
+        : `TMDB request failed (${response.status})`,
+    );
+  }
+  return (await response.json()) as T;
+}
+
+const yearOf = (date?: string | null) =>
+  date && date.length >= 4 ? date.slice(0, 4) : "";
+
+function toItem(raw: any, fallbackType?: TmdbMediaType): TmdbItem | null {
+  const mediaType: TmdbMediaType | undefined =
+    raw?.media_type === "movie" || raw?.media_type === "tv"
+      ? raw.media_type
+      : fallbackType;
+  if (!mediaType || typeof raw?.id !== "number") return null;
+  const title = raw.title || raw.name || "";
+  if (!title) return null;
+  return {
+    id: raw.id,
+    mediaType,
+    title,
+    originalTitle: raw.original_title || raw.original_name || title,
+    overview: raw.overview || "",
+    poster: raw.poster_path || null,
+    backdrop: raw.backdrop_path || null,
+    year: yearOf(raw.release_date || raw.first_air_date),
+    rating: Number(raw.vote_average) || 0,
+    originalLanguage: raw.original_language || "",
+  };
+}
+
+const toItems = (results: any[], fallbackType?: TmdbMediaType): TmdbItem[] =>
+  (Array.isArray(results) ? results : [])
+    .map((raw) => toItem(raw, fallbackType))
+    .filter((item): item is TmdbItem => !!item);
+
+// ---- Home rows -------------------------------------------------------------
+
+export const getTrending = async (signal?: AbortSignal) =>
+  toItems((await request("/trending/all/week", {}, signal)).results);
+
+export const getPopular = async (type: TmdbMediaType, signal?: AbortSignal) =>
+  toItems((await request(`/${type}/popular`, {}, signal)).results, type);
+
+export const getTopRated = async (type: TmdbMediaType, signal?: AbortSignal) =>
+  toItems((await request(`/${type}/top_rated`, {}, signal)).results, type);
+
+export const getNowPlaying = async (signal?: AbortSignal) =>
+  toItems((await request("/movie/now_playing", {}, signal)).results, "movie");
+
+export const getOnTheAir = async (signal?: AbortSignal) =>
+  toItems((await request("/tv/on_the_air", {}, signal)).results, "tv");
+
+/** Popular titles whose original language matches the user's audio language. */
+export const getPopularInLanguage = async (
+  type: TmdbMediaType,
+  language: string,
+  signal?: AbortSignal,
+) =>
+  toItems(
+    (
+      await request(
+        `/discover/${type}`,
+        {
+          with_original_language: language,
+          sort_by: "popularity.desc",
+          "vote_count.gte": 20,
+          include_adult: false,
+        },
+        signal,
+      )
+    ).results,
+    type,
+  );
+
+/** A random page of popular titles, so Home feels different between launches. */
+export const getDiscover = async (
+  type: TmdbMediaType,
+  page: number,
+  signal?: AbortSignal,
+) =>
+  toItems(
+    (
+      await request(
+        `/discover/${type}`,
+        {
+          sort_by: "popularity.desc",
+          "vote_count.gte": 200,
+          include_adult: false,
+          page,
+        },
+        signal,
+      )
+    ).results,
+    type,
+  );
+
+// ---- Search ----------------------------------------------------------------
+
+export const searchTmdb = async (
+  query: string,
+  signal?: AbortSignal,
+): Promise<TmdbItem[]> => {
+  const data = await request(
+    "/search/multi",
+    { query: query.trim(), include_adult: false },
+    signal,
+  );
+  return toItems(data.results).filter(
+    (item) => item.mediaType === "movie" || item.mediaType === "tv",
+  );
+};
+
+// ---- Details ---------------------------------------------------------------
+
+const certificationOf = (type: TmdbMediaType, data: any): string => {
+  if (type === "movie") {
+    const results: any[] = data?.release_dates?.results || [];
+    const pick =
+      results.find((r) => r.iso_3166_1 === "IN") ||
+      results.find((r) => r.iso_3166_1 === "US");
+    return (
+      pick?.release_dates?.find((r: any) => r.certification)?.certification ||
+      ""
+    );
+  }
+  const results: any[] = data?.content_ratings?.results || [];
+  const pick =
+    results.find((r) => r.iso_3166_1 === "IN") ||
+    results.find((r) => r.iso_3166_1 === "US");
+  return pick?.rating || "";
+};
+
+export const getDetails = async (
+  type: TmdbMediaType,
+  id: number,
+  signal?: AbortSignal,
+): Promise<TmdbDetails> => {
+  const data = await request(
+    `/${type}/${id}`,
+    {
+      append_to_response:
+        type === "movie"
+          ? "credits,videos,similar,release_dates"
+          : "credits,videos,similar,content_ratings",
+    },
+    signal,
+  );
+  const base = toItem({ ...data, media_type: type }, type);
+  if (!base) throw new Error("TMDB returned an unreadable title.");
+
+  const trailer = (data.videos?.results || []).find(
+    (video: any) => video.site === "YouTube" && video.type === "Trailer",
+  );
+
+  const runtime =
+    type === "movie"
+      ? Number(data.runtime) || null
+      : Number((data.episode_run_time || [])[0]) || null;
+
+  return {
+    ...base,
+    tagline: data.tagline || "",
+    genres: (data.genres || []).map((genre: any) => genre.name),
+    runtime,
+    status: data.status || "",
+    certification: certificationOf(type, data),
+    cast: (data.credits?.cast || []).slice(0, 20).map((person: any) => ({
+      id: person.id,
+      name: person.name,
+      character: person.character || "",
+      photo: person.profile_path || null,
+    })),
+    trailerKey: trailer?.key || null,
+    similar: toItems(data.similar?.results || [], type).slice(0, 15),
+    spokenLanguages: (data.spoken_languages || [])
+      .map((language: any) => language.iso_639_1)
+      .filter(Boolean),
+    seasons:
+      type === "tv"
+        ? (data.seasons || [])
+            .filter((season: any) => season.season_number > 0)
+            .map((season: any) => ({
+              number: season.season_number,
+              name: season.name || `Season ${season.season_number}`,
+              episodeCount: season.episode_count || 0,
+              airYear: yearOf(season.air_date),
+              poster: season.poster_path || null,
+            }))
+        : [],
+    numberOfSeasons: Number(data.number_of_seasons) || 0,
+    numberOfEpisodes: Number(data.number_of_episodes) || 0,
+  };
+};
+
+export const getSeason = async (
+  id: number,
+  seasonNumber: number,
+  signal?: AbortSignal,
+): Promise<TmdbSeason> => {
+  const data = await request(`/tv/${id}/season/${seasonNumber}`, {}, signal);
+  return {
+    number: data.season_number ?? seasonNumber,
+    name: data.name || `Season ${seasonNumber}`,
+    overview: data.overview || "",
+    episodes: (data.episodes || []).map((episode: any) => ({
+      number: episode.episode_number,
+      name: episode.name || `Episode ${episode.episode_number}`,
+      overview: episode.overview || "",
+      still: episode.still_path || null,
+      runtime: Number(episode.runtime) || null,
+      airDate: episode.air_date || "",
+      rating: Number(episode.vote_average) || 0,
+    })),
+  };
+};
diff --git a/src/lib/tmdbPlayback.ts b/src/lib/tmdbPlayback.ts
new file mode 100644
index 0000000..3bbf0ac
--- /dev/null
+++ b/src/lib/tmdbPlayback.ts
@@ -0,0 +1,175 @@
+// Starts playback of a SourceOption (a quality row from the Movie Based
+// layout) in the app's existing player. It mirrors what DetailScreen does for
+// provider titles: open the player on a placeholder, resolve the provider
+// stream, pick a server, then hand the real stream to usePlayerStore.
+
+import { providerApi } from "@/lib/providerApi";
+import { episodeLabel, toPlayerEpisodes } from "@/lib/episodes";
+import { selectPlaybackStreams } from "@/lib/streams";
+import { findPreferredStreamIndex } from "@/lib/audioLanguages";
+import { usePlayerStore, type PlayerMeta } from "@/store/usePlayerStore";
+import { usePreferencesStore } from "@/store/usePreferencesStore";
+import { getPreferredLanguage } from "@/store/useLayoutStore";
+import {
+  continueKey,
+  useTmdbContinueWatchingStore,
+} from "@/store/useTmdbContinueWatchingStore";
+import { currentRouteName, goBack } from "@/navigation/navigationRef";
+import type { SourceOption } from "@/lib/titleBridge";
+import type { TmdbMediaType } from "@/lib/tmdbApi";
+
+export type PlayTarget = {
+  mediaType: TmdbMediaType;
+  id: number;
+  title: string;
+  // Full image URL for the player, plus raw TMDB paths for continue watching.
+  imageUrl?: string;
+  poster: string | null;
+  backdrop: string | null;
+  season?: number;
+  episode?: number;
+  episodeTitle?: string;
+};
+
+const PENDING = "pending://stream";
+let inFlight = false;
+
+export function buildPlayerMeta(
+  option: SourceOption,
+  target: PlayTarget,
+): NonNullable<PlayerMeta> {
+  const isSeries = target.mediaType === "tv";
+  const preferred = getPreferredLanguage();
+  return {
+    title: target.title,
+    link: option.link,
+    providerId: option.providerId,
+    type: option.type,
+    image: target.imageUrl,
+    isSeries,
+    qualities: option.linkList.map((entry) => ({
+      label: entry.title || entry.quality || "Quality",
+      episodesLink: entry.episodesLink,
+      directLinks: toPlayerEpisodes(entry.directLinks),
+    })),
+    qualityIndex: option.linkIndex,
+    episodes: option.items,
+    episodeNumber: isSeries ? (target.episode ?? null) : null,
+    linkIndex: isSeries ? undefined : option.itemIndex,
+    episode: isSeries
+      ? target.episodeTitle
+        ? `S${target.season} E${target.episode} · ${target.episodeTitle}`
+        : episodeLabel(
+            { title: "", link: option.link, number: target.episode ?? null },
+            option.itemIndex,
+          )
+      : undefined,
+    preferredAudioLanguage: preferred ?? undefined,
+    tmdb: {
+      id: target.id,
+      mediaType: target.mediaType,
+      season: target.season,
+      episode: target.episode,
+      episodeTitle: target.episodeTitle,
+      poster: target.poster,
+      backdrop: target.backdrop,
+    },
+  };
+}
+
+function failPending(link: string) {
+  const state = usePlayerStore.getState();
+  if (state.currentVideoUrl === PENDING && state.playerMeta?.link === link) {
+    state.close();
+    if (currentRouteName() === "Player") goBack();
+  }
+}
+
+/**
+ * Plays one quality row. Throws an Error with a user-readable message when no
+ * stream could be started (the caller shows it); resolves quietly when the
+ * user closed or replaced the player while the provider was resolving.
+ */
+export async function playSource(
+  option: SourceOption,
+  target: PlayTarget,
+  hooks: {
+    openPlayer: () => void;
+    onStage?: (stage: string) => void;
+    signal?: AbortSignal;
+  },
+): Promise<void> {
+  if (inFlight) return;
+  inFlight = true;
+  const meta = buildPlayerMeta(option, target);
+  try {
+    useTmdbContinueWatchingStore
+      .getState()
+      .restore(continueKey(target.mediaType, target.id));
+
+    hooks.onStage?.("Preparing stream…");
+    usePlayerStore.getState().setVideo(PENDING, [], 0, meta);
+    hooks.openPlayer();
+
+    let raw: any;
+    try {
+      raw = await providerApi.getStream(
+        option.providerId,
+        option.link,
+        option.type,
+        hooks.signal,
+      );
+    } catch (error: any) {
+      failPending(option.link);
+      throw new Error(
+        error?.message || "Could not get a playable stream from this provider.",
+      );
+    }
+    if (hooks.signal?.aborted) return;
+
+    hooks.onStage?.("Checking servers…");
+    const streams: any[] = Array.isArray(raw) ? raw : raw ? [raw] : [];
+    const selection = await selectPlaybackStreams(streams, {
+      preference: usePreferencesStore.getState().defaultQuality,
+      signal: hooks.signal,
+      budgetMs: 3000,
+      probeTimeoutMs: 2600,
+    });
+    if (hooks.signal?.aborted) return;
+    if (selection.streams.length === 0) {
+      failPending(option.link);
+      throw new Error(
+        selection.skippedDownloadOnly > 0
+          ? "This provider only offers download-only servers."
+          : "This provider returned no playable stream.",
+      );
+    }
+
+    // Prefer a server whose audio matches the user's language, but never one
+    // the probe already found dead.
+    let startIndex = selection.startIndex;
+    const preferred = getPreferredLanguage();
+    if (preferred && selection.streams.length > 1) {
+      hooks.onStage?.("Choosing audio…");
+      const hit = await findPreferredStreamIndex(
+        selection.streams,
+        preferred,
+        hooks.signal,
+      );
+      if (hit >= 0 && selection.streams[hit].probe?.status !== "failed") {
+        startIndex = hit;
+      }
+    }
+
+    const state = usePlayerStore.getState();
+    if (state.currentVideoUrl !== PENDING || state.playerMeta?.link !== option.link) {
+      // Closed or replaced while resolving: do not hijack the screen.
+      return;
+    }
+    const chosen = selection.streams[startIndex] || selection.streams[0];
+    state.setVideo(chosen.link, selection.streams, startIndex, meta);
+    hooks.openPlayer();
+  } finally {
+    inFlight = false;
+  }
+}
